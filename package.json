{
  "name": "klinorbis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern core && npm run lint:styles",
    "monitor": "node scripts/klinorbis-monitor.mjs",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "lint:styles": "stylelint app/demo-design.css app/tokens.css"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.24.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "miniflare": "5.20261019.2-beta",
    "react-server-dom-webpack": "19.3.1",
    "stylelint": "17.16.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "displayName": "KLINORBIS",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "satori": {
      "fflate": "0.7.5"
    },
    "miniflare": {
      "undici": "7.30.1"
    },
    "eslint-plugin-react-hooks": {
      "zod": "4.6.7"
    }
  }
}
