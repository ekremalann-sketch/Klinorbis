{
  "name": "klinorbis-core",
  "version": "0.1.0",
  "private": true,
  "description": "Klinorbis Türkiye çekirdeği: PostgreSQL şeması, satır güvenliği, KVKK modülü ve hastane köprüsü (Türkiye'de / hastane içinde çalışır).",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "migrate": "node --experimental-strip-types src/cli/migrate.ts",
    "docs:dictionary": "node --experimental-strip-types scripts/data-dictionary.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@types/node": "22.19.19",
    "@types/pg": "8.11.10",
    "typescript": "7.0.2"
  }
}
